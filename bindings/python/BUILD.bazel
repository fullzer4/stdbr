load("@rules_rust//rust:defs.bzl", "rust_shared_library")

exports_files([
    "Cargo.toml",
    "test_parity.py",
] + glob(["src/**/*.rs"]))

rust_shared_library(
    name = "stdbr-python",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    visibility = ["//visibility:public"],
    deps = [
        "//core:stdbr-core",
        "@crates//:pyo3",
    ],
)

genrule(
    name = "stdbr-pymodule",
    srcs = [":stdbr-python"],
    outs = ["stdbr.abi3.so"],
    cmd = "cp $< $@",
    visibility = ["//visibility:public"],
)
