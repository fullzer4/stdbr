    "prepublishOnly": "napi prepublish"
  },
  "optionalDependencies": {
    "stdbr-linux-x64-gnu": "0.0.2",
    "stdbr-linux-x64-musl": "0.0.2",
    "stdbr-linux-arm64-gnu": "0.0.2",
    "stdbr-darwin-x64": "0.0.2",
    "stdbr-darwin-arm64": "0.0.2",
    "stdbr-win32-x64-msvc": "0.0.2"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2"
  }
