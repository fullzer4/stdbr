load("@rules_rust//rust:defs.bzl", "rust_test")
load(":parity.bzl", "GOLDEN_ENV", "LOCAL_TAGS", "parity_binding_test")

genrule(
    name = "gen_golden",
    outs = ["golden_generated.json"],
    cmd = "$(location //tools/parity_gen) > $@",
    tools = ["//tools/parity_gen"],
    tags = LOCAL_TAGS + ["requires-network"],
)

rust_test(
    name = "parity_rust",
    srcs = ["//core:tests/parity.rs"],
    deps = ["//core:stdbr-core", "@crates//:serde_json"],
    data = [":gen_golden"],
    env = GOLDEN_ENV,
)

cc_test(
    name = "parity_ffi_c",
    srcs = ["//bindings/ffi-c:test_parity.c"],
    deps = [
        "//bindings/ffi-c:stdbr-ffi-static",
        "//bindings/ffi-c:stdbr-header",
        "@cjson",
    ],
    data = [":gen_golden"],
    env = GOLDEN_ENV,
    tags = LOCAL_TAGS,
)

parity_binding_test(
    name = "nodejs",
    build_cmd = "cargo build -p stdbr-napi --release",
    runner_lines = ['exec node --test "$WS/bindings/nodejs/test_parity.js"'],
    test_file = "//bindings/nodejs:test_parity.js",
)

parity_binding_test(
    name = "python",
    build_cmd = (
        "[ -d .venv ] || python3 -m venv .venv && " +
        "source .venv/bin/activate && " +
        "maturin develop --manifest-path bindings/python/Cargo.toml --release"
    ),
    runner_lines = [
        'source "$WS/.venv/bin/activate"',
        'exec python3 "$WS/bindings/python/test_parity.py"',
    ],
    test_file = "//bindings/python:test_parity.py",
)

parity_binding_test(
    name = "wasm",
    build_cmd = "wasm-pack build bindings/wasm --target nodejs --release",
    runner_lines = [
        'export WASM_PKG="$WS/bindings/wasm/pkg/stdbr_wasm.js"',
        'exec node --test "$WS/bindings/wasm/test_parity.js"',
    ],
    test_file = "//bindings/wasm:test_parity.js",
)
